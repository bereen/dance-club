---
// src/pages/faq.astro — Страница «Вопросы и ответы» (FAQ)
// Вопросы подтягиваются из src/content/faq, сортируются по полю order
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const faqItems = (await getCollection('faq', ({ data }) => data.published))
  .sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Вопросы и ответы — Танцы для взрослых" description="Частые вопросы о занятиях бальными танцами для взрослых: одежда, партнёр, запись, оплата.">
  <section class="max-w-3xl mx-auto px-6 py-16 sm:py-24">
    <h1 class="font-display text-4xl font-bold text-bordo mb-4">Вопросы и ответы</h1>
    <p class="text-warmgray/80 mb-12">
      Собрали то, что чаще всего спрашивают перед первым занятием.
      Не нашли свой вопрос? Напишите нам — добавим ответ сюда.
    </p>

    {faqItems.length > 0 ? (
      <div class="space-y-4">
        {faqItems.map((item) => (
          <details class="group bg-white rounded-2xl shadow-md open:shadow-lg transition-shadow">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none p-5 sm:p-6">
              <span class="font-semibold text-bordo text-lg">{item.data.question}</span>
              <span class="flex-shrink-0 w-8 h-8 rounded-full bg-sand text-terra-dark flex items-center justify-center font-bold group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
            </summary>
            <div class="px-5 sm:px-6 pb-6 pt-0 text-warmgray/90 leading-relaxed border-t border-sand/70">
              <p class="mt-4">{item.data.answer}</p>
              <p class="mt-3 text-sm text-warmgray/60">Тема: {item.data.category}</p>
            </div>
          </details>
        ))}
      </div>
    ) : (
      <p class="text-warmgray/70 italic">Вопросы скоро появятся.</p>
    )}

    <div class="mt-12 bg-bordo-dark text-cream rounded-2xl p-6 sm:p-8 text-center">
      <p class="text-lg mb-2">Остались вопросы?</p>
      <a href="/#zapis" class="inline-block px-6 py-3 rounded-xl bg-terra hover:bg-terra-light text-white font-semibold transition-colors">
        Записаться на пробное занятие — спросим лично
      </a>
    </div>
  </section>
</BaseLayout>
