---
// src/pages/materials.astro — Страница «Обучающие материалы»
import BaseLayout from '../layouts/BaseLayout.astro';
import MaterialCard from '../components/MaterialCard.astro';
import { getCollection } from 'astro:content';

const materials = await getCollection('materials', ({ data }) => data.published);
---
<BaseLayout title="Обучающие материалы — Танцы для взрослых" description="Библиотека видеоуроков, статей и методических пособий для участников клуба.">
  <section class="max-w-6xl mx-auto px-6 py-16 sm:py-24">
    <h1 class="font-display text-4xl font-bold text-bordo mb-4">Обучающие материалы</h1>
    <p class="text-warmgray/80 mb-12 max-w-2xl">
      Библиотека видеоуроков, статей и методических пособий.
      Все материалы открываются на Яндекс.Диске в новой вкладке.
    </p>

    {materials.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {materials.map((material) => (
          <MaterialCard
            type={material.data.type}
            title={material.data.title}
            description={material.data.description}
            duration={material.data.duration}
            level={material.data.level}
            link={material.data.link}
          />
        ))}
      </div>
    ) : (
      <p class="text-warmgray/70 italic">Материалы скоро появятся.</p>
    )}
  </section>
</BaseLayout>
