---
// src/pages/events.astro — Страница «Мероприятия»
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection } from 'astro:content';

const events = (await getCollection('events', ({ data }) => data.published))
  .sort((a, b) => a.data.date.localeCompare(b.data.date));
---
<BaseLayout title="Мероприятия — Танцы для взрослых" description="Анонсы балов, вечеров, семинаров и мастер-классов клуба бальных танцев.">
  <section class="max-w-6xl mx-auto px-6 py-16 sm:py-24">
    <h1 class="font-display text-4xl font-bold text-bordo mb-4">Мероприятия</h1>
    <p class="text-warmgray/80 mb-12 max-w-2xl">
      Здесь появляются анонсы балов, танцевальных вечеров, семинаров и мастер-классов.
      Чтобы записаться на участие, нажмите кнопку под анонсом — откроется форма заявки.
    </p>

    {events.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {events.map((event) => (
          <EventCard
            type={event.data.type}
            date={event.data.date}
            dateLabel={event.data.dateLabel}
            title={event.data.title}
            description={event.data.description}
            time={event.data.time}
            place={event.data.place}
            signupUrl={event.data.signupUrl}
          />
        ))}
      </div>
    ) : (
      <p class="text-warmgray/70 italic">Мероприятия скоро появятся — загляните через несколько дней.</p>
    )}
  </section>
</BaseLayout>
