---
// src/pages/index.astro — Главная страница сайта
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EventCard from '../components/EventCard.astro';
import MaterialCard from '../components/MaterialCard.astro';
import SignupForm from '../components/SignupForm.astro';
import { getCollection } from 'astro:content';

// Avtomaticheski podtyagivaem vse meropriyatiya i sortiruem po date
const events = (await getCollection('events', ({ data }) => data.published))
  .sort((a, b) => a.data.date.localeCompare(b.data.date))
  .slice(0, 3);

// Avtomaticheski podtyagivaem poslednie 3 materiala
const materials = (await getCollection('materials', ({ data }) => data.published))
  .slice(0, 3);
---
<BaseLayout title="Танцы для взрослых — клуб бальных танцев для взрослых 30+">
  <Hero />

  <!-- BLIZHAISHIE MEROPRIYATIYA -->
  <section class="max-w-6xl mx-auto px-6 py-16 sm:py-24" aria-labelledby="events-title">
    <h2 id="events-title" class="font-display text-3xl sm:text-4xl font-bold text-bordo mb-3">
      Ближайшие мероприятия
    </h2>
    <p class="text-warmgray/80 mb-10 max-w-2xl">
      Анонсы танцевальных вечеров, балов, семинаров и мастер-классов.
      Нажмите «Записаться на участие» — откроется форма заявки.
    </p>

    {events.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {events.map((event) => (
          <EventCard
            type={event.data.type}
            date={event.data.date}
            dateLabel={event.data.dateLabel}
            title={event.data.title}
            description={event.data.description}
            time={event.data.time}
            place={event.data.place}
            signupUrl={event.data.signupUrl}
          />
        ))}
      </div>
    ) : (
      <p class="text-warmgray/70 italic">Мероприятия скоро появятся — загляните через несколько дней.</p>
    )}

    <div class="mt-8 text-center">
      <a href="/events" class="inline-flex items-center gap-2 text-terra-dark hover:text-terra font-semibold">
        Все мероприятия →
      </a>
    </div>
  </section>

  <!-- OBUCHAYUSHCHIE MATERIALY -->
  <section class="bg-cream py-16 sm:py-24" aria-labelledby="materials-title">
    <div class="max-w-6xl mx-auto px-6">
      <h2 id="materials-title" class="font-display text-3xl sm:text-4xl font-bold text-bordo mb-3">
        Обучающие материалы
      </h2>
      <p class="text-warmgray/80 mb-10 max-w-2xl">
        Библиотека видеоуроков, статей и методических пособий.
        Материалы открываются на Яндекс.Диске в новой вкладке.
      </p>

      {materials.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {materials.map((material) => (
            <MaterialCard
              type={material.data.type}
              title={material.data.title}
              description={material.data.description}
              duration={material.data.duration}
              level={material.data.level}
              link={material.data.link}
            />
          ))}
        </div>
      ) : (
        <p class="text-warmgray/70 italic">Материалы скоро появятся.</p>
      )}

      <div class="mt-8 text-center">
        <a href="/materials" class="inline-flex items-center gap-2 text-terra-dark hover:text-terra font-semibold">
          Все материалы →
        </a>
      </div>
    </div>
  </section>

  <SignupForm />
</BaseLayout>
