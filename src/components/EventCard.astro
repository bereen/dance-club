---
// src/components/EventCard.astro
// Карточка мероприятия. Один блок = одно мероприятие.
// При добавлении через Decap CMS — данные подставляются автоматически.

export interface Props {
  type: string;        // 'Бал' | 'Семинар' | 'Вечер' | 'Мастер-класс' | 'Лекция'
  date: string;        // ISO-формат: '2026-11-15'
  dateLabel: string;    // Человекочитаемая дата: '15 ноября'
  title: string;
  description: string;
  time: string;        // '19:00 — 22:00'
  place: string;       // 'Большой зал'
  signupUrl: string;   // ссылка на форму записи
}

const { type, date, dateLabel, title, description, time, place, signupUrl } = Astro.props;
---
<article class="bg-white rounded-2xl shadow-md hover:shadow-xl transition-shadow duration-300 overflow-hidden border border-sand flex flex-col">
  <div class="px-6 pt-5 flex items-center justify-between">
    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-terra/10 text-terra-dark text-sm font-medium">
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a1 1 0 011 1v1h2a1 1 0 110 2h-2v2h3a1 1 0 110 2h-3v6a1 1 0 11-2 0v-6H6a1 1 0 110-2h3V6H7a1 1 0 110-2h2V3a1 1 0 011-1z"/></svg>
      {type}
    </span>
    <time datetime={date} class="text-warmgray/70 text-sm font-medium">{dateLabel}</time>
  </div>

  <div class="px-6 py-5 flex-1 flex flex-col">
    <h3 class="font-display text-xl font-bold text-bordo mb-2">{title}</h3>
    <p class="text-warmgray/80 mb-4 text-base leading-relaxed flex-1">{description}</p>

    <div class="flex items-center gap-4 text-sm text-warmgray/70 mb-5">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-terra" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {time}
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-terra" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.244-4.243a8 8 0 1111.314 0z"/><circle cx="12" cy="11" r="2" stroke="none"/></svg>
        {place}
      </span>
    </div>

    <a href={signupUrl} class="block w-full text-center px-6 py-3 rounded-xl bg-terra hover:bg-terra-light text-white font-semibold transition-colors duration-200 min-h-[52px] leading-8">
      Записаться на участие
    </a>
  </div>
</article>
