---
// src/components/MaterialCard.astro
// Карточка обучающего материала (видео / статья / методичка)

export interface Props {
  type: 'Видео' | 'Статья' | 'Методичка';
  title: string;
  description: string;
  duration: string;        // '12 минут' / '8 страниц' / '7 минут чтения'
  level: string;           // 'Для всех' / 'Начальный' / 'Средний' / 'Продолжающий'
  link: string;            // публичная ссылка на Яндекс.Диск
}

const { type, title, description, duration, level, link } = Astro.props;

// Подбор иконки и цвета в зависимости от типа контента
const iconConfig = {
  'Видео': { bg: 'bg-terra/10', text: 'text-terra-dark' },
  'Методичка': { bg: 'bg-bordo/10', text: 'text-bordo' },
  'Статья': { bg: 'bg-warmgray/10', text: 'text-warmgray' },
};
const cfg = iconConfig[type];
---
<article class="bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow duration-300 border border-sand overflow-hidden flex flex-col">
  <div class="p-6 flex-1 flex flex-col">
    <div class={`w-14 h-14 rounded-xl ${cfg.bg} flex items-center justify-center mb-4`}>
      {type === 'Видео' && (
        <svg class={`w-7 h-7 ${cfg.text}`} fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 6a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/>
          <path d="M14 7l4-2v10l-4-2" stroke="white" stroke-width="1.5" fill="none"/>
        </svg>
      )}
      {type !== 'Видео' && (
        <svg class={`w-7 h-7 ${cfg.text}`} fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
      )}
    </div>

    <span class={`inline-block self-start px-2.5 py-1 rounded-md ${cfg.bg} ${cfg.text} text-xs font-semibold mb-3 uppercase tracking-wide`}>
      {type}
    </span>

    <h3 class="font-display text-lg font-bold text-bordo mb-2">{title}</h3>
    <p class="text-warmgray/80 mb-4 text-base leading-relaxed flex-1">{description}</p>

    <div class="flex flex-wrap items-center gap-2 mb-5 text-sm text-warmgray/70">
      <span class="px-2 py-0.5 rounded bg-sand/60 text-warmgray">{duration}</span>
      <span class="px-2 py-0.5 rounded bg-sand/60 text-warmgray">{level}</span>
    </div>

    <a href={link} target="_blank" rel="noopener noreferrer" class="block w-full text-center px-5 py-3 rounded-xl border-2 border-terra text-terra-dark hover:bg-terra hover:text-white font-semibold transition-colors duration-200 min-h-[52px] leading-8">
      Открыть материал →
    </a>
  </div>
</article>
